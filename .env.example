GEMINI_API_KEY=

# FinGenEval Enterprise local service. Use a managed secret store in production.
FINGENEVAL_ENVIRONMENT=development
FINGENEVAL_DATABASE_URL=sqlite:///fingeneval.db
FINGENEVAL_EXECUTION_MODE=eager
FINGENEVAL_LOCAL_AUTH_ENABLED=true
FINGENEVAL_REPORT_DIR=reports/generated
FINGENEVAL_LOG_LEVEL=INFO

# Pin the exact generation model used for each validation run.
FINGENEVAL_GEMINI_MODEL=gemini-2.5-flash
# Minimum seconds between LLM calls (rate limit). Not counted as latency.
FINGENEVAL_LLM_MIN_INTERVAL_SECONDS=4

FINGENEVAL_TOP_K=5
FINGENEVAL_CHUNK_SIZE_TOKENS=400
FINGENEVAL_CHUNK_OVERLAP_TOKENS=80
FINGENEVAL_HYBRID_VECTOR_WEIGHT=0.5
FINGENEVAL_HYBRID_BM25_WEIGHT=0.5
FINGENEVAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FINGENEVAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
