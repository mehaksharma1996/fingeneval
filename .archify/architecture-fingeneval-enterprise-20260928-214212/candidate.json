  "cards": [
    {
      "dot": "emerald",
      "title": "Release safety",
      "items": [
        "Agents collect evidence and summaries; the deterministic policy engine owns the release outcome.",
        "Partial runs or provider errors produce insufficient evidence instead of a complete recommendation.",
        "High-risk outcomes support recorded human review, justified override, and targeted remediation reruns."
      ]
    },
    {
      "dot": "cyan",
      "title": "Local development adapters",
      "items": [
        "Credential-free runs use a deterministic model provider, SQLite, local job execution, and filesystem reports.",
        "Hosted model and S3 integrations remain explicit adapter boundaries and are disabled locally."
      ]
    },
    {
      "dot": "amber",
      "title": "Data scope",
      "items": [
        "Bundled AML and complaint evaluation packs, identities, and outcomes are synthetic.",
        "The local workflow validates evaluation and governance behavior; it does not establish regulatory compliance."
      ]
    }
  ]
