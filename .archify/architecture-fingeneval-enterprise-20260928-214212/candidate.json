  "cards": [
    {
      "dot": "emerald",
      "title": "Supported scope",
      "items": [
        "The Streamlit UI and CLI share one offline evaluation engine.",
        "The harness evaluates financial-policy RAG configurations; it does not serve end-user questions.",
        "Agents, tool execution, chat memory, and business dashboards are explicit non-goals."
      ]
    },
    {
      "dot": "cyan",
      "title": "Measurement integrity",
      "items": [
        "Retrieval metrics are measured independently of hosted generation.",
        "Answer metrics exist only for successful LLM rows; retrieval-only and failed rows remain empty.",
        "Retrieval and generation latency are separated after method warm-up."
      ]
    },
    {
      "dot": "amber",
      "title": "Repository boundary",
      "items": [
        "The FastAPI/React governance prototype is retained but is not the canonical product path.",
        "Cloud and production-scale capabilities are not claimed by this supported architecture."
      ]
    }
